      "id": "vscode", "name": "Visual Studio Code", "category": "dev", "icon": "@code.visualstudio.com",
      "desc": { "pl": "Edytor kodu od Microsoft (instalacja dla wszystkich użytkowników).", "en": "Code editor by Microsoft (system-wide install)." },
