      "detect": "^PowerShell 7",
      "sources": [
        { "type": "github", "repo": "PowerShell/PowerShell", "asset": "^PowerShell-[\\d\\.]+-win-x64\\.msi$", "installer": "msi", "args": "ADD_PATH=1 ENABLE_PSREMOTING=0 REGISTER_MANIFEST=1 USE_MU=1 ENABLE_MU=1", "signer": "Microsoft Corporation" },
        { "type": "winget", "id": "Microsoft.PowerShell" },
        { "type": "choco", "id": "powershell-core" }
      ]
    },
    {
      "id": "terminal", "name": "Windows Terminal", "category": "dev", "icon": "@learn.microsoft.com",
