      "detect": "^Python 3\\.\\d+.*\\(64-bit\\)",
      "sources": [
        { "type": "ps", "fileName": "python-amd64.exe", "args": "/quiet InstallAllUsers=1 PrependPath=1 Include_test=0",
          "script": "$h=(Invoke-WebRequest 'https://www.python.org/downloads/windows/' -UseBasicParsing).Content; if($h -match 'https://www\\.python\\.org/ftp/python/(3\\.\\d+\\.\\d+)/python-3\\.\\d+\\.\\d+-amd64\\.exe'){ $matches[0] } else { exit 1 }" },
        { "type": "winget", "id": "Python.Python.3.13" },
        { "type": "choco", "id": "python" }
      ]
    },
    {
      "id": "nodejs", "name": "Node.js LTS", "category": "dev", "icon": "@nodejs.org",
      "desc": { "pl": "Środowisko JavaScript — aktualna wersja LTS z npm.", "en": "JavaScript runtime — current LTS with npm." },
      "detect": "^Node\\.js",
      "sources": [
        { "type": "ps", "installer": "msi", "fileName": "node-lts-x64.msi",
          "script": "$r=Invoke-RestMethod 'https://nodejs.org/dist/index.json' | Where-Object { $_.lts } | Select-Object -First 1; 'https://nodejs.org/dist/' + $r.version + '/node-' + $r.version + '-x64.msi'" },
        { "type": "winget", "id": "OpenJS.NodeJS.LTS" },
        { "type": "choco", "id": "nodejs-lts" }
      ]
    },
    {
      "id": "powershell", "name": "PowerShell 7", "category": "dev", "icon": "@learn.microsoft.com",
