      "sources": [
        { "type": "url", "url": "https://update.code.visualstudio.com/latest/win32-x64/stable", "fileName": "VSCodeSetup-x64.exe", "args": "/VERYSILENT /NORESTART /MERGETASKS=!runcode,addcontextmenufiles,addcontextmenufolders,addtopath", "signer": "Microsoft Corporation" },
        { "type": "winget", "id": "Microsoft.VisualStudioCode", "extra": "--scope machine" },
        { "type": "choco", "id": "vscode" }
      ]
    },
    {
      "id": "git", "name": "Git for Windows", "category": "dev", "icon": "@git-scm.com",
      "desc": { "pl": "System kontroli wersji z Git Bash.", "en": "Version control with Git Bash." },
      "detect": "^Git$|^Git version",
      "sources": [
        { "type": "github", "repo": "git-for-windows/git", "asset": "^Git-[\\d\\.]+-64-bit\\.exe$", "args": "/VERYSILENT /NORESTART /NOCANCEL /SP- /CLOSEAPPLICATIONS" },
        { "type": "winget", "id": "Git.Git" },
        { "type": "choco", "id": "git" }
      ]
