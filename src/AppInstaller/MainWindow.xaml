<Window x:Class="AppInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:AppInstaller.Core"
        Title="{Binding [AppTitle], Source={x:Static core:Loc.I}}"
        Width="1100" Height="720" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackdropBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource TextFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Kafelek aplikacji -->
        <DataTemplate x:Key="AppCard">
            <Border x:Name="card" Margin="4" Padding="12,10" Height="84" CornerRadius="{StaticResource CardRadius}"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1"
                    Cursor="Hand" MouseLeftButtonUp="Card_Click" ToolTip="{Binding SourcesText}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- ikona z fallbackiem na monogram -->
                    <Grid Width="32" Height="32" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0">
                        <Border CornerRadius="6" Background="{Binding MonogramBrush}">
                            <TextBlock Text="{Binding Monogram}" Foreground="White" FontWeight="SemiBold" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="6" Background="{DynamicResource FlyoutBrush}"
                                Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                            <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="2,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Subtitle}" TextTrimming="CharacterEllipsis"/>
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource SuccessBgBrush}"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding [Installed], Source={x:Static core:Loc.I}}" FontSize="11"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                   MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <CheckBox Grid.Column="2" VerticalAlignment="Top" Margin="0,2,0,0" IsChecked="{Binding IsChecked}"
                              Visibility="{Binding IsCore, Converter={StaticResource InverseBoolToVis}}"/>
                    <TextBlock Grid.Column="2" Text="&#xE72E;" Style="{StaticResource Glyph}" VerticalAlignment="Top" Margin="0,4,2,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" FontSize="14"
                               Visibility="{Binding IsCore, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="card" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCore}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}"/>
                    <Setter TargetName="card" Property="Cursor" Value="Arrow"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="CardPanel">
            <UniformGrid Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top"/>
        </ItemsPanelTemplate>

        <!-- Wiersz postępu instalacji -->
        <DataTemplate x:Key="InstallRow">
            <Border Margin="0,0,0,4" Padding="14,10" CornerRadius="{StaticResource CardRadius}"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="24" Height="24" CornerRadius="5" Background="{Binding Tile.MonogramBrush}" HorizontalAlignment="Left">
                        <Grid>
                            <TextBlock Text="{Binding Tile.Monogram}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border CornerRadius="5" Background="{DynamicResource FlyoutBrush}"
                                    Visibility="{Binding Tile.HasIcon, Converter={StaticResource BoolToVis}}">
                                <Image Source="{Binding Tile.Icon}" Width="18" Height="18"/>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="{Binding Tile.Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Item.Status}" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                        </Grid>
                        <ProgressBar x:Name="bar" Margin="0,8,0,0" Value="{Binding Item.Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding Item.IsIndeterminate, Mode=OneWay}" Visibility="Hidden"/>
                    </StackPanel>
                    <TextBlock x:Name="glyph" Grid.Column="2" Style="{StaticResource Glyph}" Text="&#xE823;"
                               Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Item.IsActive}" Value="True">
                    <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="glyph" Property="Text" Value="&#xE896;"/>
                    <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Item.State}" Value="Installing">
                    <Setter TargetName="glyph" Property="Text" Value="&#xE7B8;"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Item.State}" Value="Waiting">
                    <Setter TargetName="glyph" Property="Text" Value="&#xE73E;"/>
                    <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Item.State}" Value="Done">
                    <Setter TargetName="glyph" Property="Text" Value="&#xEC61;"/>
                    <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Item.State}" Value="Failed">
                    <Setter TargetName="glyph" Property="Text" Value="&#xEB90;"/>
                    <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= NAGŁÓWEK ================= -->
        <Grid Margin="16,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="15" Foreground="{DynamicResource OnAccentBrush}"/>
                </Border>
                <TextBlock Text="{Binding [AppTitle], Source={x:Static core:Loc.I}}" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="14"/>
            </StackPanel>
            <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource SearchBox}" MaxWidth="420" HorizontalAlignment="Stretch"
                     Tag="{Binding [Search], Source={x:Static core:Loc.I}}" TextChanged="Search_Changed"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button x:Name="LangButton" Style="{StaticResource SubtleButton}" Click="Lang_Click" Height="36" MinWidth="44"
                        ToolTip="{Binding [Language], Source={x:Static core:Loc.I}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xF2B7;" Style="{StaticResource Glyph}" FontSize="15"/>
                        <TextBlock x:Name="LangText" Text="PL" Margin="6,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ThemeButton" Style="{StaticResource SubtleButton}" Click="Theme_Click" Height="36" Width="40" Margin="4,0,0,0">
                    <TextBlock x:Name="ThemeGlyph" Text="&#xE793;" Style="{StaticResource Glyph}" FontSize="15"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= WIDOK WYBORU ================= -->
        <Grid x:Name="SelectView" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- panel kategorii (na Mica) -->
            <DockPanel Margin="8,4,8,12">
                <TextBlock x:Name="CatalogInfo" DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="12,8,4,0" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                <ListBox x:Name="CategoryList" Style="{StaticResource NavList}" SelectionChanged="Category_Changed">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- warstwa treści (jak w aplikacjach Windows 11) -->
            <Border Grid.Column="1" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource LayerStrokeBrush}"
                    BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- InfoBar aktualizacji -->
                    <Border x:Name="UpdateBar" Margin="20,16,20,0" Padding="14,10" CornerRadius="{StaticResource CardRadius}"
                            Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1"
                            Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="Update_Click"
                                    Content="{Binding [UpdateNow], Source={x:Static core:Loc.I}}"/>
                            <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0"/>
                            <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12,16,12">
                        <StackPanel>
                            <TextBlock x:Name="LoadingText" Text="{Binding [Loading], Source={x:Static core:Loc.I}}"
                                       Style="{StaticResource Caption}" Margin="4,8"/>

                            <StackPanel x:Name="CorePanel" Visibility="Collapsed" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,2">
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding [Core], Source={x:Static core:Loc.I}}" Style="{StaticResource Subtitle}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding [CoreHint], Source={x:Static core:Loc.I}}" Style="{StaticResource Caption}" Margin="4,0,0,6"/>
                                <ItemsControl x:Name="CoreItems" ItemTemplate="{StaticResource AppCard}" ItemsPanel="{StaticResource CardPanel}"/>
                            </StackPanel>

                            <TextBlock x:Name="SectionTitle" Style="{StaticResource Subtitle}" Margin="4,0,0,6"/>
                            <ItemsControl x:Name="AppItems" ItemTemplate="{StaticResource AppCard}" ItemsPanel="{StaticResource CardPanel}"/>
                            <TextBlock x:Name="NoResults" Text="{Binding [NoResults], Source={x:Static core:Loc.I}}" Style="{StaticResource Caption}"
                                       Margin="4,24" HorizontalAlignment="Center" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- stopka z akcją -->
                    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}" Padding="20,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{Binding [Clear], Source={x:Static core:Loc.I}}" Click="Clear_Click" Margin="0,0,8,0"/>
                                <Button x:Name="InstallButton" Style="{StaticResource AccentButton}" Click="Install_Click" MinWidth="150">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource OnAccentBrush}"/>
                                        <TextBlock x:Name="InstallText" Foreground="{DynamicResource OnAccentBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="SelectedText" VerticalAlignment="Center" Style="{StaticResource Caption}" FontSize="13"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= WIDOK INSTALACJI ================= -->
        <Border x:Name="InstallView" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource LayerBrush}"
                BorderBrush="{DynamicResource LayerStrokeBrush}" BorderThickness="0,1,0,0">
            <Grid MaxWidth="900" Margin="24,20,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock x:Name="InstallTitle" Style="{StaticResource Title}"/>
                    <TextBlock x:Name="InstallSubtitle" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,10"/>
                    <ProgressBar x:Name="OverallBar" Height="4" Maximum="100"/>
                    <Border x:Name="ResultBar" Margin="0,14,0,0" Padding="14,10" CornerRadius="{StaticResource CardRadius}" Visibility="Collapsed"
                            BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock x:Name="ResultGlyph" Style="{StaticResource Glyph}" Margin="0,0,12,0"/>
                            <TextBlock x:Name="ResultText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="InstallItems" ItemTemplate="{StaticResource InstallRow}"/>
                </ScrollViewer>
                <DockPanel Grid.Row="2" Margin="0,14,0,0">
                    <Button Content="{Binding [OpenLog], Source={x:Static core:Loc.I}}" Click="OpenLog_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="RestartButton" Content="{Binding [Restart], Source={x:Static core:Loc.I}}" Click="Restart_Click"
                                Margin="0,0,8,0" Visibility="Collapsed"/>
                        <Button x:Name="BackButton" Content="{Binding [Back], Source={x:Static core:Loc.I}}" Click="Back_Click"
                                Margin="0,0,8,0" Visibility="Collapsed"/>
                        <Button x:Name="CancelButton" Content="{Binding [Cancel], Source={x:Static core:Loc.I}}" Click="Cancel_Click" Margin="0,0,8,0"/>
                        <Button x:Name="CloseButton" Style="{StaticResource AccentButton}" Content="{Binding [Close], Source={x:Static core:Loc.I}}"
                                Click="Close_Click" MinWidth="110" IsEnabled="False"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
