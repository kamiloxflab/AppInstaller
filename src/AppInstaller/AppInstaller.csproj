<Project Sdk="Microsoft.NET.Sdk">

  <!--
    .NET Framework 4.8 jest wbudowany w Windows 10 1903+ i Windows 11, dzięki czemu
    wynikowy AppInstaller.exe to JEDEN plik ~0,5 MB bez żadnych zależności
    (self-contained .NET 8/9/10 ważyłby 60–150 MB, a instalator i tak ma dopiero instalować .NET).
    Budowanie: wystarczy .NET SDK (nie trzeba Visual Studio):  dotnet build -c Release
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>AppInstaller</AssemblyName>
    <RootNamespace>AppInstaller</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 64-bit na 64-bitowym Windows: poprawne %ProgramFiles% i widok rejestru -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <Version>1.0.0</Version>
    <Product>AppInstaller</Product>
    <Description>Instalator najnowszych wersji aplikacji</Description>
    <Copyright>MIT</Copyright>

    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- pozwala budować net48 na dowolnym komputerze / w CI bez Targeting Packa -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <!-- katalog wbudowany (fallback offline) — ten sam plik co publikowany na GitHub Pages -->
    <EmbeddedResource Include="..\..\catalog\apps.json" LogicalName="AppInstaller.apps.json" />
    <!-- klucz publiczny do weryfikacji podpisów katalogu i aktualizacji (tworzy go tools\New-SigningKey.ps1) -->
    <EmbeddedResource Include="..\..\keys\public.xml" LogicalName="AppInstaller.public.xml" Condition="Exists('..\..\keys\public.xml')" />
  </ItemGroup>

</Project>
